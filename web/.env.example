# ============================================================================
# OfferFlow 网页版环境变量模板
#   用法：cp .env.example .env  然后按需填写
#   ⚠ .env 已被 .gitignore 排除，不要提交真实密钥
# ============================================================================

# ---- 运行环境：development | staging | production ----
APP_ENV=development

# ---- LLM（BYOK；也可留空，改在前端「模型配置」里按用户填 Key）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ---- 安全（生产环境务必替换；开发可留默认）----
# 用于字段级加密的密钥，建议 32 字节随机串
ENCRYPTION_KEY=change-me-to-a-random-32-byte-secret
# 用于签发 JWT
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 数据库（docker compose 内已指向容器内 Postgres；本地裸跑默认 SQLite）----
# DATABASE_URL=postgresql+psycopg://offerflow:offerflow@postgres:5432/offerflow
# DATABASE_URL=sqlite:///./offerflow.db

# ---- 默认演示账号（首次启动自动创建的本地账号）----
DEFAULT_USER_ID=default
DEFAULT_USER_NAME=demo
DEFAULT_USER_PASSWORD=demo1234

# ---- CORS（按你的前端地址改）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# ---- SMTP（可选：找回密码发信；不配则不发信）----
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASSWORD=your-smtp-auth-code
# SMTP_FROM=OfferFlow <you@qq.com>
